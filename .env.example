# LLM API Configuration
# Copy this file to .env and fill in your values

# Provider: openai, openrouter, or local
# This mainly affects default base URL if LLM_BASE_URL is not set
LLM_PROVIDER=openai

# API base URL (overrides provider default if set)
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1
#   vLLM:        http://localhost:8000/v1
# LLM_BASE_URL=https://api.openai.com/v1

# API key
LLM_API_KEY=sk-...

# Model name
# OpenAI examples:      gpt-4o-mini, gpt-4o
# OpenRouter examples:  openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, google/gemini-2.0-flash-exp:free
LLM_MODEL=gpt-4o-mini

# OpenRouter-specific (optional)
# Your site URL for rankings (optional)
# OPENROUTER_SITE_URL=https://your-site.com
# Your app name for rankings (optional)
# OPENROUTER_APP_NAME=AnkiVocabGenerator
