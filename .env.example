# ankigen Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# LLM Provider Settings
# =============================================================================

# Provider: openai, anthropic, openrouter, or local
LLM_PROVIDER=openrouter

# API key for your provider
LLM_API_KEY=sk-or-...

# Model name (provider-specific)
# OpenAI: gpt-4o-mini, gpt-4o, etc.
# Anthropic: claude-sonnet-4-6, claude-haiku-4-5-20251001, etc.
# OpenRouter: openai/gpt-4o-mini, google/gemini-2.0-flash-001, etc.
# Local: llama3, etc.
LLM_MODEL=google/gemini-2.0-flash-001

# Optional: Override base URL (useful for proxies or custom endpoints)
# LLM_BASE_URL=https://api.openai.com/v1

# OpenRouter-specific (optional)
# OPENROUTER_SITE_URL=https://your-site.com
# OPENROUTER_APP_NAME=ankigen

# =============================================================================
# Watch Folder Settings (for batch extraction)
# =============================================================================

# Base watch folder (language subfolders will be appended: watch/zh/, watch/ko/)
# ANKIGEN_WATCH_DIR=./watch

# Language-specific watch folders (override the base + subfolder pattern)
# ANKIGEN_WATCH_DIR_ZH=./watch/zh
# ANKIGEN_WATCH_DIR_KO=./watch/ko

# Base output directory for extracted vocabulary
# ANKIGEN_OUTPUT_DIR=./inputs

# Base processed folder (language subfolders will be appended)
# ANKIGEN_PROCESSED_DIR=./processed

# Language-specific processed folders (override the base + subfolder pattern)
# ANKIGEN_PROCESSED_DIR_ZH=./processed/zh
# ANKIGEN_PROCESSED_DIR_KO=./processed/ko

# =============================================================================
# Anki Database Filtering (optional)
# =============================================================================

# Path to your Anki database (.anki2 direct SQLite or .apkg exported package).
# Common locations:
#   macOS:   ~/Library/Application Support/Anki2/User 1/collection.anki2
#   Linux:   ~/.local/share/Anki2/User 1/collection.anki2
#   Windows: %APPDATA%\Anki2\User 1\collection.anki2
# ANKIGEN_ANKI_DB=~/Library/Application Support/Anki2/User 1/collection.anki2

# Deck name to check for existing words — set per language.
# Words already present in the named deck will be skipped during extract, clean, and generate.
# Use '::' for sub-decks (e.g. Chinese::Vocabulary).
# ANKIGEN_ANKI_DECK_ZH=Chinese::Vocabulary
# ANKIGEN_ANKI_DECK_KO=Korean::Vocabulary

# Which note field contains the vocabulary word. Accepts either:
#   - A 0-based integer index (e.g. 0 for the first field)
#   - A field name string (e.g. "Hanzi") — resolved from the note type schema
# To find field names: open a card in Anki → Edit → the field names are listed.
# Defaults to 0 (first field) if not set.
# ANKIGEN_ANKI_FIELD_ZH=Hanzi
# ANKIGEN_ANKI_FIELD_KO=Korean
#
# Note for `--mode grammar` runs: point ANKIGEN_ANKI_DECK_{LANG} and
# ANKIGEN_ANKI_FIELD_{LANG} (or pass --anki-deck/--anki-field on the CLI) at
# your *grammar* deck and pattern field instead, e.g.:
#   ANKIGEN_ANKI_DECK_KO=Korean::Grammar
#   ANKIGEN_ANKI_FIELD_KO=Pattern
#
# Live DB: Opening collection.anki2 while Anki is running may fail (SQLite lock).
# Quit Anki or use an exported .apkg (or a file copy) for reliable reads.
#
# Matching uses Unicode NFC so the same word in different normalized forms still matches.

# =============================================================================
# Logging Settings
# =============================================================================

# Log directory for daily log files
# ANKIGEN_LOG_DIR=./logs

# File log level: DEBUG, INFO, WARNING, ERROR
# ANKIGEN_LOG_LEVEL=DEBUG

# Days to keep log files (-1 = keep forever)
# ANKIGEN_LOG_RETENTION=-1
